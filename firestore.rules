rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Game documents
    match /games/{gameId} {
      // Värd kan skapa och uppdatera sitt eget spel
      allow create: if request.auth.uid != null;
      allow write: if request.auth.uid == resource.data.hostUid;
      
      // 🔧 Läsa: Två vägar för åtkomst:
      // 1. Inloggad app-användare (befintlig auth-baserad)
      // 2. Oautentiserad spektator - tillåtet om spelet har publicToken
      allow read: if request.auth.uid != null
                  || (request.auth == null && resource.data.publicToken != null);
      
      // Spectators subcollection
      match /spectators/{spectatorUid} {
        allow create: if request.auth.uid == spectatorUid;
        allow delete: if request.auth.uid == spectatorUid;
        
        // Spectators kan läsa sin egen document
        allow read: if request.auth.uid == spectatorUid;
      }
      
      // Players subcollection - läsbar för inloggade och webb-spektatorer
      match /players/{playerName} {
        // Inloggade app-användare eller oautentiserade spektatorer (om spelet har publicToken)
        allow read: if request.auth.uid != null
                    || (request.auth == null && get(/databases/$(database)/documents/games/$(gameId)).data.publicToken != null);
      }
    }

    // ── Score Battle rum ──────────────────────────────────────────────────────
    match /scoreBattleRooms/{gameId} {
      // Alla kan läsa (webbspelare saknar auth)
      allow read: if true;

      // Värd skapar rummet
      allow create: if request.auth != null && request.auth.uid != null;

      // Värd kan uppdatera allt; oautentiserade kan bara ändra webGuesses-fältet
      allow update: if
        (request.auth != null && request.auth.uid == resource.data.hostUid)
        || (
          request.resource.data.keys().hasAll(resource.data.keys())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['webGuesses'])
        );

      // Värd tar bort rummet när spelet är slut
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostUid;
    }

    // ── Användarens egna seenSongs ───────────────────────────────────────────
    match /users/{uid}/seenSongs/{docId} {
      // Endast inloggad användare med samma uid får läsa/skriva
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny-all fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

