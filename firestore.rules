rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Game documents
    match /games/{gameId} {
      // Värd kan skapa och uppdatera sitt eget spel
      allow create: if request.auth.uid != null;
      allow write: if request.auth.uid == resource.data.hostUid;
      
      // 🔧 Läsa: Värd kan läsa sitt eget spel, eller alla inloggade kan läsa (för att validera kod)
      allow read: if request.auth.uid != null;
      
      // Spectators subcollection
      match /spectators/{spectatorUid} {
        allow create: if request.auth.uid == spectatorUid;
        allow delete: if request.auth.uid == spectatorUid;
        
        // Spectators kan läsa sin egen document
        allow read: if request.auth.uid == spectatorUid;
      }
    }

    // Deny-all fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

